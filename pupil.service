[Unit]
Description=Track Eye - per-eye pupil tracking + ESP32 servo feed
After=network-online.target
Wants=network-online.target
# Chạy liên tục: không bao giờ bỏ cuộc dù crash lặp lại (mặc định systemd dừng
# sau 5 lần restart trong 10s).
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi5
WorkingDirectory=/home/pi5/track-eye
# ESP_HOST rỗng -> run_pupil.sh tự lấy địa chỉ broadcast của mạng hiện tại.
#   AP chặn broadcast? đổi thành:  Environment=ESP_HOST=192.168.1.182
#   Chạy không servo?              Environment=ESP_HOST=off
Environment=ESP_HOST=
# USB camera can take a few seconds to enumerate after power-on: wait for it.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do [ -e /dev/video0 ] && exit 0; sleep 1; done'
ExecStart=/home/pi5/track-eye/run_pupil.sh
Restart=always
RestartSec=3
SyslogIdentifier=pupil

[Install]
WantedBy=multi-user.target
